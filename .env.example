# Sales Management environment template
# Copy to .env and run: cp .env.example .env && docker compose up
# Every default below works for local development without editing anything.

# Spring profile. "dev" applies the migrations AND seeds the demo accounts.
# Use "prod" for anything real: it migrates and seeds nothing.
SPRING_PROFILE=dev

# PostgreSQL
DB_NAME=sales_db
DB_USER=sales_user
DB_PASSWORD=sales_pass
DB_PORT=5434

# Redis
REDIS_PORT=6380

# Published ports
API_PORT=8080
WEB_PORT=3000

# Base64 secret used to sign JWTs. Replace this for anything but local dev.
JWT_SECRET=bXktc3VwZXItc2VjcmV0LWtleS1jaGFuZ2UtaW4tcHJvZHVjdGlvbi1hdC1sZWFzdC0yNTYtYml0cw==
